{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Ayal": "YOUR_DB_CONNECTION_STRING",
    "Redis": "YOUR_REDIS_CONNECTION_STRING"
  },
  "Redis": {
    "TTL": 30
  },
  "Jwt": {
    "Key": "YOUR_JWT_SECRET_KEY_MIN_32_CHARS",
    "Issuer": "GiftForU",
    "Audience": "GiftForUUsers"
  },
  "Kafka": {
    "BootstrapServers": "localhost:9093",
    "OrderTopic": "orders"
  }
}
